# Normalize line endings so the repo is identical on every platform.
* text=auto eol=lf

*.py     text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.json   text eol=lf
*.cfg    text eol=lf
LICENSE  text eol=lf

# Windows entrypoints keep CRLF so cmd.exe does not choke
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

*.png    binary
*.jpg    binary
*.ico    binary
*.exe    binary
*.dll    binary
*.zip    binary
